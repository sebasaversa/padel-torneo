{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      "$tournamentId": {
        ".read": false,
        ".write": false,
        "public": {
          ".read": "auth != null && (auth.token.platformRole === 'superAdmin' || root.child('tournamentAccess').child($tournamentId).child('members').child(auth.uid).exists())",
          ".write": false
        },
        "_server": {
          ".read": false,
          ".write": false
        }
      }
    },
    "tournamentAccess": {
      "$tournamentId": {
        ".read": false,
        ".write": false
      }
    },
    "tournamentPresence": {
      "$tournamentId": {
        ".read": "auth != null && (auth.token.platformRole === 'superAdmin' || root.child('tournamentAccess').child($tournamentId).child('members').child(auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (auth.token.platformRole === 'superAdmin' || root.child('tournamentAccess').child($tournamentId).child('members').child(auth.uid).exists())",
          ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('updatedAt').exists())"
        }
      }
    },
    "creationRequests": {
      ".read": false,
      ".write": false
    },
    "usernameDirectory": {
      ".read": false,
      ".write": false
    },
    "userProfiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.platformRole === 'superAdmin')",
        ".write": false
      }
    },
    "adminActivity": {
      ".read": "auth != null && auth.token.platformRole === 'superAdmin'",
      ".write": false
    }
  }
}
